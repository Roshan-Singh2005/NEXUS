generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  messages  Message[]
}

model Message {
  id        String   @id @default(uuid())
  prompt    String
  response  String
  userId    String  
  user      User     @relation(fields: [userId], references: [id])
}
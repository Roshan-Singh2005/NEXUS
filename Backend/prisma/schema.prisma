generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email String @unique
  name String
  password String 
  messages Message[]
  pastConversations PastConversation[]

}

model PastConversation {
  id        String   @id @default(uuid())
  userId String  
  prompt String
  user User @relation(fields: [userId], references: [id])
  messages Message[]

}


model Message {
  id        String   @id @default(uuid())
  prompt String
  userId String  
  response String
  user User @relation(fields: [userId], references: [id])
  pastConversationId String?
  pastConversation PastConversation? @relation(fields: [pastConversationId], references: [id])
}